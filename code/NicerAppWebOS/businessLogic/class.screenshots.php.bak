    // ------------------------------------------------------------------
    // Queue API
    // ------------------------------------------------------------------

    /**
     * Enqueue a screenshot job (async)
     *
     * Options:
     *   - force        (bool)   Force a new capture even if one exists
     *   - retain       (int)    Seconds: if an existing ready screenshot is younger than this, return it instead of enqueuing
     *   - priority     (int)    Higher = more urgent
     *   - maxAttempts  (int)
     *   - width, height, meta, etc.
     *
     * Returns the job / existing document
     */
    public function enqueue(string $url, array $options = []): array
    {
        $url = trim($url);
        if ($url === '') {
            throw new InvalidArgumentException('URL is required');
        }

        $force  = (bool)($options['force']  ?? false);
        $retain = (int)($options['retain'] ?? 0);   // 0 = always create new (unless force=false and ready exists with no retain)

        // Look for an existing record
        $existing = $this->findByUrl($url);

        if ($existing && !$force) {
            $status = $existing['status'] ?? '';

            // If it's already ready and still within the retain window → serve the old one
            if ($status === 'ready' && $retain > 0) {
                $createdTs = strtotime($existing['created'] ?? $existing['updated'] ?? '0');
                $age = time() - $createdTs;

                if ($age < $retain) {
                    // Still fresh enough → return existing
                    return $existing;
                }
            }

            // If it's already pending or processing and we don't force → just return it
            if (in_array($status, ['pending', 'processing'], true)) {
                return $existing;
            }
        }

        // --- From here we create / reset a new job ---

        $paths = $this->buildFilePath($url);
        $now   = date('Y-m-d H:i:s');

        $job = [
            'url'          => $url,
            'urlHash'      => $paths['filename'],
            'filePath'     => $paths['absolute'],
            'relativePath' => $paths['relative'],
            'width'        => (int)($options['width']  ?? 1280),
            'height'       => (int)($options['height'] ?? 630),
            'status'       => 'pending',
            'priority'     => (int)($options['priority'] ?? 0),
            'attempts'     => 0,
            'maxAttempts'  => (int)($options['maxAttempts'] ?? 3),
            'lockedAt'     => null,
            'lockedBy'     => null,
            'created'      => $now,
            'updated'      => $now,
            'error'        => null,
            'meta'         => $options['meta'] ?? [],
            'retain'       => $retain,                 // store the requested retain value (optional but useful)
        ];

        if ($existing) {
            // Reset the existing job
            $this->db->updateMany(
                ['url' => $url],
                ['$set' => $job]
            );
            $job['_id'] = $existing['_id'] ?? null;
        } else {
            $result = $this->db->insertOne($job);
            $job['_id'] = $result['_id'] ?? null;
        }

        return $job;
    }
