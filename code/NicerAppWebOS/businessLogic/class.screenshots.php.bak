     'priority' => 5
     ]);

     // Force a brand new one regardless of age
     $screenshots->enqueue('https://nicer.app', [
     'force'  => true,
     'retain' => 3600   // retain is ignored when force=true
     ]);

     // No retain → always enqueue a new job (unless one is already pending/processing)
     $screenshots->enqueue('https://nicer.app');
