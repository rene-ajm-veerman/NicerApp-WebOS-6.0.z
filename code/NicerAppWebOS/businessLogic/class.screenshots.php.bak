    /**
     * Claim the next pending job (atomic-ish)
     * Returns the job or null if none available
     */
    public function claimNextJob(string $workerId = 'default'): ?array
    {
        // First release stale locks
        $this->releaseStaleLocks();

        // Find highest priority pending job
        $jobs = $this->db->find(
            ['status' => 'pending'],
            [
                'sort'  => ['priority' => -1, 'created' => 1],
                'limit' => 1
            ]
        );

        if (empty($jobs)) {
            return null;
        }

        $job = $jobs[0];
        $now = date('Y-m-d H:i:s');

        // Mark as processing
        $updated = $this->db->updateMany(
            [
                'url'    => $job['url'],
                'status' => 'pending'          // only if still pending
            ],
            [
                '$set' => [
                    'status'   => 'processing',
                    'lockedAt' => $now,
                    'lockedBy' => $workerId,
                    'updated'  => $now,
                    'attempts' => ($job['attempts'] ?? 0) + 1
                ]
            ]
        );

        if ($updated < 1) {
            // Someone else claimed it
            return null;
        }

        $job['status']   = 'processing';
        $job['lockedAt'] = $now;
        $job['lockedBy'] = $workerId;
        $job['attempts'] = ($job['attempts'] ?? 0) + 1;

        return $job;
    }

    /**
     * Process a single claimed job (calls Node/Puppeteer)
     */
    public function processJob(array $job): array
    {
        $url   = $job['url'];
        $paths = $this->buildFilePath($url);

        $this->ensureDirectory($paths['dir']);

        $cmd = sprintf(
            'node %s %s %s 2>&1',
            escapeshellarg($this->nodeScript),
            escapeshellarg($url),
            escapeshellarg($paths['absolute'])
        );

        $output = [];
        $returnCode = 0;
        exec($cmd, $output, $returnCode);

        $success = ($returnCode === 0 && file_exists($paths['absolute']));
        $now = date('Y-m-d H:i:s');

        if ($success) {
            $update = [
                'status'   => 'ready',
                'filePath' => $paths['absolute'],
                'relativePath' => $paths['relative'],
                'lockedAt' => null,
                'lockedBy' => null,
                'error'    => null,
                'updated'  => $now,
            ];
        } else {
            $attempts = (int)($job['attempts'] ?? 1);
            $maxAttempts = (int)($job['maxAttempts'] ?? 3);

            $update = [
                'status'   => ($attempts >= $maxAttempts) ? 'failed' : 'pending',
                'lockedAt' => null,
                'lockedBy' => null,
                'error'    => implode("\n", $output),
                'updated'  => $now,
            ];
        }

        $this->db->updateMany(['url' => $url], ['$set' => $update]);

        return array_merge($job, $update);
    }

    /**
     * Worker loop – processes jobs until queue is empty or $maxJobs reached
     */
    public function runWorker(string $workerId = 'default', int $maxJobs = 10, int $sleepSeconds = 2): void
    {
        $processed = 0;

        while ($processed < $maxJobs) {
            $job = $this->claimNextJob($workerId);

            if (!$job) {
                // Nothing left
                break;
            }

            echo "[" . date('H:i:s') . "] Processing: {$job['url']}\n";
            $result = $this->processJob($job);
            echo "[" . date('H:i:s') . "] → {$result['status']}\n";

            $processed++;
            if ($sleepSeconds > 0) {
                sleep($sleepSeconds);
            }
        }
    }

    /**
     * Release jobs that have been locked too long
     */
    public function releaseStaleLocks(): int
    {
        $cutoff = date('Y-m-d H:i:s', time() - $this->lockTimeoutSeconds);

        // This is a simplified version – adjust depending on your uDB2 capabilities
        $stale = $this->db->find([
            'status'   => 'processing',
            'lockedAt' => ['$lt' => $cutoff]
        ]);

        $count = 0;
        foreach ($stale as $job) {
            $this->db->updateMany(
                ['url' => $job['url']],
                ['$set' => [
                    'status'   => 'pending',
                    'lockedAt' => null,
                    'lockedBy' => null,
                    'updated'  => date('Y-m-d H:i:s')
                ]]
            );
            $count++;
        }

        return $count;
    }



    /**
     * Ensure the recommended indexes exist.
     * Call this once during setup / migration.
     */
    public function ensureIndexes(): void
    {
        if ($this->db->isCouchDB ?? false) {          // adjust to how you detect the driver
            $this->createCouchIndexes();
        } else {
            $this->createSqlIndexes();
        }
    }

    private function createSqlIndexes(): void
    {
        $indexes = [
            "CREATE UNIQUE INDEX IF NOT EXISTS idx_url ON `{$this->table}` (url)",
            "CREATE INDEX IF NOT EXISTS idx_status_created ON `{$this->table}` (status, created)",
            "CREATE INDEX IF NOT EXISTS idx_queue ON `{$this->table}` (status, priority DESC, created ASC)",
            "CREATE INDEX IF NOT EXISTS idx_status_updated ON `{$this->table}` (status, updated)",
        ];

        foreach ($indexes as $sql) {
            try {
                $this->db->query($sql);   // or however your uDB2 exposes raw SQL
            } catch (Throwable $e) {
                // Index may already exist – ignore
            }
        }
    }

    private function createCouchIndexes(): void
    {
        // Example using the underlying CouchDB connector
        // (adjust to your actual connector API)

        $indexes = [
            [
                'index' => ['fields' => ['url']],
                'name'  => 'idx-url',
                'type'  => 'json'
            ],
            [
                'index' => ['fields' => ['status', 'created']],
                'name'  => 'idx-status-created',
                'type'  => 'json'
            ],
            [
                'index' => ['fields' => ['status', 'priority', 'created']],
                'name'  => 'idx-queue',
                'type'  => 'json'
            ],
        ];

        foreach ($indexes as $def) {
            try {
                $this->db->couchConnector->cdb->createIndex($def);
            } catch (Throwable $e) {
                // already exists
            }
        }
    }


    /**
     * Scan the comments database (cms_comments) and enqueue screenshots
     * for every unique URL found in rootItemJSON.
     *
     * @param array $options  Same options as enqueue() + extra:
     *                        - retain (int)
     *                        - force (bool)
     *                        - limit (int)   Max number of unique URLs to process
     *                        - dryRun (bool) Only return the list, don't enqueue
     *
     * @return array  Summary of what was processed
     */
    public function enqueueFromComments(array $options = []): array
    {
        global $naWebOS;

        $retain  = (int)($options['retain']  ?? 0);
        $force   = (bool)($options['force']   ?? false);
        $limit   = (int)($options['limit']   ?? 0);     // 0 = no limit
        $dryRun  = (bool)($options['dryRun']  ?? false);

        // --- Connect to the comments database ---
        $db = $naWebOS->dbs->findConnection('couchdb');
        $cdb = $db->cdb;
        $dbName = $db->dataSetName('cms_comments');

        try {
            $cdb->setDatabase($dbName, true);
        } catch (Exception $e) {
            throw new RuntimeException("Could not open cms_comments database: " . $e->getMessage());
        }

        // --- Fetch all documents (paginated) ---
        $uniqueUrls = [];
        $bookmark = null;
        $pageSize = 200;

        do {
            $query = [
                'selector' => new stdClass(),          // match everything
                'fields'   => ['rootItemJSON'],
                'limit'    => $pageSize,
            ];

            if ($bookmark) {
                $query['bookmark'] = $bookmark;
            }

            $result = $cdb->find($query);
            $docs = $result->body->docs ?? [];

            foreach ($docs as $doc) {
                if (empty($doc->rootItemJSON)) continue;

                // rootItemJSON is a JSON string like: {"url":"https://..."}
                $root = json_decode($doc->rootItemJSON, true);
                if (!is_array($root) || empty($root['url'])) continue;

                $url = trim($root['url']);
                if ($url !== '') {
                    $uniqueUrls[$url] = true;   // use as set
                }
            }

            $bookmark = $result->body->bookmark ?? null;

            // Safety: stop if we already have enough unique URLs
            if ($limit > 0 && count($uniqueUrls) >= $limit) {
                break;
            }

        } while ($bookmark && $bookmark !== 'nil' && count($docs) > 0);

        $urls = array_keys($uniqueUrls);

        if ($limit > 0) {
            $urls = array_slice($urls, 0, $limit);
        }

        // --- Enqueue them ---
        $summary = [
            'totalUniqueUrls' => count($urls),
            'enqueued'        => 0,
            'skipped'         => 0,
            'errors'          => [],
            'urls'            => []
        ];

        foreach ($urls as $url) {
            try {
                if ($dryRun) {
                    $summary['urls'][] = $url;
                    $summary['enqueued']++;
                    continue;
                }

                $job = $this->enqueue($url, [
                    'retain' => $retain,
                    'force'  => $force,
                    'meta'   => [
                        'source' => 'comments-scan',
                        'scannedAt' => date('c')
                    ]
                ]);

                $summary['urls'][] = [
                    'url'    => $url,
                    'status' => $job['status'] ?? 'unknown',
                    '_id'    => $job['_id'] ?? null
                ];

                if (($job['status'] ?? '') === 'pending') {
                    $summary['enqueued']++;
                } else {
                    $summary['skipped']++;   // already ready / within retain window
                }

            } catch (Throwable $e) {
                $summary['errors'][] = [
                    'url'   => $url,
                    'error' => $e->getMessage()
                ];
            }
        }

        return $summary;
    }
    /*
     $screenshots = new naScreenshots($uDB2);

     // Scan all comments and enqueue screenshots, keep existing ones for 24 hours
     $result = $screenshots->enqueueFromComments([
     'retain' => 86400,          // 24 hours
     'force'  => false
     ]);

     // Dry-run (just list the unique URLs)
     $result = $screenshots->enqueueFromComments([
     'dryRun' => true,
     'limit'  => 50
     ]);

     // Force re-capture of everything found in comments
     $result = $screenshots->enqueueFromComments([
     'force'  => true,
     'retain' => 0
     ]);
     */


    // ------------------------------------------------------------------
    // Query helpers
    // ------------------------------------------------------------------

    public function findByUrl(string $url): ?array
    {
        return $this->db->findOne(['url' => $url]);
    }

    public function list(array $filter = [], array $options = []): array
    {
        return $this->db->find($filter, $options);
    }

    public function getPendingCount(): int
    {
        $rows = $this->db->find(['status' => 'pending']);
        return count($rows);
    }

    public function delete(string $url): bool
    {
        $rec = $this->findByUrl($url);
        if (!$rec) return false;

        if (!empty($rec['filePath']) && file_exists($rec['filePath'])) {
            @unlink($rec['filePath']);
        }

        return $this->db->deleteOne(['url' => $url]);
    }
}
